# Zero-config path: set this and NEXUS AI works immediately with no Vault
# setup. Get a key at https://build.nvidia.com (NVIDIA NIM API).
NVIDIA_API_KEY=

# Optional overrides for the zero-config NVIDIA path
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
PORT=8787

# Multi-provider keys (Gemini, Groq, NVIDIA) with fallback ordering are
# configured through the app itself: Settings -> API Vault. Those keys are
# stored in server/data/vault.json (git-ignored) — not in this file.
